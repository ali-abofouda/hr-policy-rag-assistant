# ---------------------------------------------------------------------------
# deploy.env.yaml.example - Template Environment Variables for Google Cloud Run
# Copy to deploy.env.yaml and populate with production credentials:
#   cp deploy.env.yaml.example deploy.env.yaml
# Passed to Cloud Run via: gcloud run deploy --env-vars-file=deploy.env.yaml
# ---------------------------------------------------------------------------

PROJECT_ID: "your-gcp-project-id"
LOCATION: "us-central1"
GCS_BUCKET_NAME: "your-gcs-bucket-name"

# Jina Embeddings (local FastEmbed active when empty)
JINA_API_KEY: ""

# Qdrant Cloud Vector Database
QDRANT_URL: "https://your-cluster-id.us-central1-0.gcp.cloud.qdrant.io"
QDRANT_API_KEY: "your-qdrant-api-key"
QDRANT_COLLECTION_NAME: "hr_policies"
QDRANT_NOISY_COLLECTION_NAME: "hr_policies_noisy_demo"

# LLM Gateway
GEMINI_API_KEY: "your-gemini-api-key"
LLM_MODEL_NAME: "gemini-3.5-flash-lite"
EMBEDDING_MODEL_NAME: "jina-embeddings-v2-base-en"
RERANKER_MODEL_NAME: "jina-reranker-v2-base-multilingual"

# Observability & Tracing (LangSmith)
LANGSMITH_TRACING: "true"
LANGSMITH_ENDPOINT: "https://api.smith.langchain.com"
LANGSMITH_API_KEY: "your-langsmith-api-key"
LANGSMITH_PROJECT: "hr-policy-assistant"

# LLM Fallback & Evaluation Judge (Groq)
GROQ_API_KEY: "your-groq-api-key"
GROQ_BASE_URL: "https://api.groq.com/openai/v1"
FALLBACK_MODEL_NAME: "openai/gpt-oss-20b"
JUDGE_MODEL_NAME: "openai/gpt-oss-120b"

# Reliability & Safety Guardrails
GUARDRAIL_PROVIDER: "gemini_lite"
GUARDRAIL_OUTPUT_PROVIDER: "local"
SEMANTIC_CACHE_THRESHOLD: "0.80"

# Access Control & OAuth Whitelist
ALLOWED_EMPLOYEE_EMAILS: "mentordivesh@gmail.com"
