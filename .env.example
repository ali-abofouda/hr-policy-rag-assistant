# Environment Variables Template for HR Policy RAG Assistant
# Copy this file to .env and populate with your credentials.

PROJECT_ID=your-gcp-project-id
LOCATION=us-central1

# Google Cloud Storage
GCS_BUCKET_NAME=your-bucket-name

# Jina AI (Embeddings + Re-ranker) - https://jina.ai (Free tier)
JINA_API_KEY=your-jina-api-key-here

# Models Configuration
LLM_MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL_NAME=jina-embeddings-v2-base-en
RERANKER_MODEL_NAME=jina-reranker-v2-base-multilingual

# Qdrant Vector Database - https://cloud.qdrant.io (Free tier) or local
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=hr_policies
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# LangSmith Observability & Tracing - https://smith.langchain.com (Free tier)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=hr-policy-assistant
