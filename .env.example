# ---------------------------------------------------------------------------
# 1. Local GCP Placeholders (Inert for local disk ingestion)
# ---------------------------------------------------------------------------
PROJECT_ID=rag-hr-assistant-local
LOCATION=us-central1
GCS_BUCKET_NAME=local-bucket

# ---------------------------------------------------------------------------
# 2. Jina AI (Embeddings & Re-ranker: Free 1M tokens from jina.ai)
# ---------------------------------------------------------------------------
JINA_API_KEY=your_jina_api_key_here

# ---------------------------------------------------------------------------
# 3. Qdrant Cloud (Vector Database: Free cluster from cloud.qdrant.io)
# ---------------------------------------------------------------------------
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=hr_policies
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# ---------------------------------------------------------------------------
# 4. LLM Inference (Free Gemini from Google AI Studio or Groq)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-2.5-flash
EMBEDDING_MODEL_NAME=jina-embeddings-v2-base-en
RERANKER_MODEL_NAME=jina-reranker-v2-base-multilingual

# ---------------------------------------------------------------------------
# 5. Observability & Tracing (Optional - Keep false initially)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-policy-assistant